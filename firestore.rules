rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All Firestore access goes exclusively through the backend (Firebase
    // Admin SDK), which bypasses these rules entirely. The frontend never
    // uses the Firestore client SDK, so direct client access must be denied
    // outright — there is no legitimate case for request.auth-based access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
